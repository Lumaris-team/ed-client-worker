{
  // ed-client-worker — internal ÉcoleDirecte API.
  // No public URL: only reachable through service bindings from other
  // workers of the same account (env.ED_CLIENT.fetch(...)).
  "name": "ed-client-worker",
  "main": "src/index.js",
  "compatibility_date": "2026-07-19",
  "workers_dev": false,
  "compatibility_flags": ["nodejs_compat"],

  // Observability
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
